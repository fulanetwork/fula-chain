                    "build":  "hardhat --config ./hardhat.config.js compile \u0026\u0026 node export-artifacts.js"
                },
    "devDependencies":  {
                            "hardhat":  "2.25.0"
                        },
    "dependencies":  {
                         "@hyperlane-xyz/core":  "12.1.0",
                         "@openzeppelin/contracts":  "4.9.3",
                         "@openzeppelin/contracts-upgradeable":  "4.9.3"
                     }
}
