# FULA Base <-> SKALE Hyperlane agents — environment for docker-compose.yml.
# install.sh copies this to /opt/fula-hyperlane/.env and fills in the generated keys.
# NEVER commit a filled-in .env. NEVER paste the keys anywhere else.

# Hyperlane agent image tag (https://github.com/hyperlane-xyz/hyperlane-monorepo/releases, agents-v*).
AGENT_TAG=agents-v2.3.0

# Chain names as in the agent config (registry names). Mainnet: base / skaleeuropa.
# Testnet rehearsal: basesepolia / skalebasesepolia.
BASE_CHAIN=base
SKALE_CHAIN=skaleeuropa
# Upper-case copies for the HYP_CHAINS_<NAME>_* env var names (install.sh derives them).
BASE_CHAIN_UPPER=BASE
SKALE_CHAIN_UPPER=SKALEEUROPA

# Block numbers to start indexing from (the router deployment block on Base, the mailbox block on SKALE).
BASE_INDEX_FROM=0
SKALE_INDEX_FROM=0

# Hex private keys (0x...). Generated by install.sh if empty; chmod 600 on .env.
VALIDATOR_KEY=
RELAYER_KEY=

# Relayer message filter: only OUR routers, both directions. JSON array of matching-list entries.
# install.sh renders this from the router addresses you pass (--base-router / --skale-router).
RELAYER_WHITELIST=[]

# We do not charge interchain gas (SKALE gas is free; Base delivery costs cents and we pay it).
GAS_PAYMENT_ENFORCEMENT=[{"type":"none"}]

# uid:gid the containers run as (the `hyperlane` system user created by install.sh).
AGENT_UID=1000
AGENT_GID=1000

# Optional: external heartbeat URL pinged by healthcheck.sh every 5 minutes (e.g. a healthchecks.io
# check). If the server dies, the "no ping" alert comes from OUTSIDE the box.
HEARTBEAT_URL=

# Optional: alert webhook (Slack/Discord/Telegram-bot style URL that accepts a JSON {"text": ...} POST).
ALERT_WEBHOOK=

# Public RPCs used by healthcheck.sh/status.sh (not by the agents; they use agent-config.json).
BASE_RPC=https://mainnet.base.org
SKALE_RPC=https://mainnet.skalenodes.com/v1/elated-tan-skat

# Alert thresholds
RELAYER_MIN_BASE_ETH=0.005
VALIDATOR_MAX_CHECKPOINT_AGE_SEC=900
