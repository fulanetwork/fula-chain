{
  "name": "fula-chain",
  "private": true,
  "version": "1.0.0",
  "description": "Fula Blockchain EVM code",
  "scripts": {
    "lint": "eslint --color --ext .ts scripts/",
    "lint:fix": "yarn run lint --fix",
    "hardhat": "hardhat",
    "build": "hardhat compile",
    "hardhat:setpk": "yarn hardhat vars set PK",
    "hardhat:setadminpk": "yarn hardhat vars set ADMIN_PK",
    "hardhat:setbase": "yarn hardhat vars set BASESCAN_API_KEY",
    "deploy:localhost": "yarn hardhat run scripts/localhost.ts",
    "test:governance": "set REPORT_GAS=true && yarn hardhat test test/governance/GovernanceModule.test.ts",
    "test:token": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/StorageToken.test.ts",
    "test:distribution": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/TokenDistributionEngine.test.ts",
    "test:airdrop": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/AirDropContract.test.ts",
    "test:mining": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/TestnetMiningRewards.test.ts",
    "test:bridge": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/TokenBridgeContract.test.ts",
    "test:bridge:oft": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/FulaOFTBridge.test.ts",
    "test:layout": "yarn hardhat test test/governance/integration/StorageTokenLayout.test.ts",
    "test:fork:token": "yarn hardhat test test/fork/StorageTokenUpgrade.fork.test.ts",
    "bridge:reconcile": "yarn hardhat run scripts/bridge/reconcileSupply.ts",
    "bridge:reconcile:testnet": "set TESTNET=1 && yarn hardhat run scripts/bridge/reconcileSupply.ts",
    "bridge:rehearse": "yarn hardhat run scripts/bridge/rehearseUpgradeOnFork.ts",
    "bridge:preflight": "DRY_RUN=1 yarn hardhat run scripts/bridge/deployStorageTokenImpl.ts",
    "refill:dryrun:base": "yarn hardhat run scripts/RefillTreasury/deployRefillTreasury.ts --network base",
    "refill:dryrun:skale": "yarn hardhat run scripts/RefillTreasury/deployRefillTreasury.ts --network skale",
    "refill:dryrun:ethereum": "yarn hardhat run scripts/RefillTreasury/deployRefillTreasury.ts --network ethereum",
    "refill:deploy:base": "set DEPLOY=1 && yarn hardhat run scripts/RefillTreasury/deployRefillTreasury.ts --network base",
    "refill:deploy:skale": "set DEPLOY=1 && yarn hardhat run scripts/RefillTreasury/deployRefillTreasury.ts --network skale",
    "refill:deploy:ethereum": "set DEPLOY=1 && yarn hardhat run scripts/RefillTreasury/deployRefillTreasury.ts --network ethereum",
    "refill:status:base": "yarn hardhat run scripts/RefillTreasury/refillTreasury.ts --network base",
    "refill:status:skale": "yarn hardhat run scripts/RefillTreasury/refillTreasury.ts --network skale",
    "refill:status:ethereum": "yarn hardhat run scripts/RefillTreasury/refillTreasury.ts --network ethereum",
    "refill:rehearse:sepolia": "yarn hardhat run scripts/RefillTreasury/rehearseSepolia.ts --network sepolia",
    "test:refill": "yarn hardhat test test/governance/integration/FulaRefillTreasury.test.ts test/independent-audit/invariants.test.ts test/independent-audit/lensA-fundsafety.test.ts test/independent-audit/lensC-erc20.test.ts test/independent-audit/lensE-coverage.test.ts test/independent-audit/lensF-redteam.test.ts",
    "hl:build": "cd scripts/hyperlane/hl-contracts && npm install --no-audit --no-fund && npm run build",
    "hl:core:dryrun:skale": "yarn hardhat run scripts/hyperlane/deployCore.ts --network skale",
    "hl:core:deploy:skale": "set DEPLOY=1 && yarn hardhat run scripts/hyperlane/deployCore.ts --network skale",
    "hl:core:deploy:testnet": "set DEPLOY=1 && yarn hardhat run scripts/hyperlane/deployCore.ts --network skale-base-sepolia",
    "hl:warp:dryrun:mainnet": "yarn hardhat run scripts/hyperlane/deployWarp.ts --network skale",
    "hl:warp:deploy:mainnet": "set DEPLOY=1 && yarn hardhat run scripts/hyperlane/deployWarp.ts --network skale",
    "hl:warp:deploy:testnet": "set DEPLOY=1 && yarn hardhat run scripts/hyperlane/deployWarp.ts --network skale-base-sepolia",
    "hl:agent-config:mainnet": "yarn hardhat run scripts/hyperlane/agentConfig.ts --network skale",
    "hl:agent-config:testnet": "yarn hardhat run scripts/hyperlane/agentConfig.ts --network skale-base-sepolia",
    "hl:status:mainnet": "yarn hardhat run scripts/hyperlane/laneStatus.ts --network skale",
    "hl:status:testnet": "yarn hardhat run scripts/hyperlane/laneStatus.ts --network skale-base-sepolia",
    "hl:canary:base": "yarn hardhat run scripts/hyperlane/canary.ts --network base",
    "hl:canary:skale": "yarn hardhat run scripts/hyperlane/canary.ts --network skale",
    "test:hyperlane": "yarn hardhat test test/hyperlane/warpRoute.test.ts",
    "test:staking": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/StakingEngine.test.ts",
    "test:stakingpool": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/StakingPool.test.ts",
    "test:stakinglinear": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/StakingEngineLinear.test.ts",
    "test:voting": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/CommunityVoting.test.ts",
    "test:voting:all": "set REPORT_GAS=true && yarn hardhat test test/governance/integration/CommunityVoting*.test.ts",
    "test": "yarn hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.9",
    "@nomicfoundation/hardhat-ethers": "3.0.9",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.13",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@nomicfoundation/hardhat-web3-v4": "^1.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.2.0",
    "@types/eslint": "9.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": ">=9.1.0",
    "@types/node": "24.0.13",
    "@types/yargs": "^17.0.33",
    "chai": "^4.2.0",
    "eslint": "9.31.0",
    "ethereum-waffle": "^4.0.10",
    "ethers": "6.15.0",
    "hardhat": "2.25.0",
    "hardhat-gas-reporter": "2.3.0",
    "js-yaml": "^4.1.0",
    "solidity-coverage": "0.8.16",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.2",
    "typescript": "5.8.3",
    "web3": "^4.5.0"
  },
  "packageManager": "yarn@3.8.0",
  "dependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.148",
    "@layerzerolabs/oapp-evm": "^0.4.1",
    "@layerzerolabs/oft-evm": "^4.0.1",
    "@nomicfoundation/hardhat-ignition": "0.15.12",
    "@openzeppelin/contracts": "5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.3.0",
    "@openzeppelin/upgrades-core": "^1.44.1",
    "@polkadot/util-crypto": "^13.5.3",
    "hardhat-contract-sizer": "^2.10.0",
    "solidity-bytes-utils": "^0.8.2",
    "tslib": "^2.8.1"
  }
}
